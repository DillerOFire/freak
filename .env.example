# Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Docker: compose sets ENV_FILE=/data/.env (persisted on the ./data volume).
# The bot seeds that file on first run; use /bot_env and /set_env in a DM to edit keys.

# Required
TELEGRAM_BOT_TOKEN=
LLM_API_KEY=
# OPENROUTER_API_KEY may be used instead when the gateway is OpenRouter.
ADMIN_ID=123456789

# OpenAI-compatible LLM gateway (defaults to OpenRouter)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Separate base URLs for ponder agent and vision (default to LLM_BASE_URL)
# LLM_PONDER_BASE_URL=https://openrouter.ai/api/v1
# LLM_VISION_BASE_URL=https://openrouter.ai/api/v1

# Main chat model (persona replies, reactions, memory tool routing)
LLM_MODEL=google/gemini-3-flash-preview
# LLM_REASONING_EFFORT=low   # Optional: none|minimal|low|medium|high|xhigh (empty = model default). Use none to disable. Required-reasoning models (Gemini 3.x) reject none.

# Sandboxed ponder / research agent (web search, page fetch, memory recall)
LLM_PONDER_MODEL=deepseek/deepseek-v4-flash
# LLM_PONDER_REASONING_EFFORT=medium   # Optional: none|minimal|low|medium|high|xhigh (empty = model default)
# Maximum research/tool iterations before a final synthesis-only call (1-20)
LLM_PONDER_MAX_STEPS=10

# Vision (image / video frame analysis)
LLM_VISION_MODEL=minimax/minimax-m3
# LLM_VISION_REASONING_EFFORT=low   # Optional: none|minimal|low|medium|high|xhigh (empty = model default)

# OpenRouter/Gemini/Anthropic prompt caching for stable system prompts
LLM_PROMPT_CACHE=true
# Rolling history prefix: keep 20 stable messages, grow to 30, then rotate 10
# messages together. Requires LLM_PROMPT_CACHE.
LLM_HISTORY_CACHE=true

# Gateway attribution (optional; used by OpenRouter)
LLM_REFERER=https://github.com/your-org/freak
LLM_TITLE=Freak Telegram Bot

# Firecrawl (optional): default web search plus dedicated page-to-markdown
# extraction for the ponder agent. Leave blank to use the DDGS fallback.
# FIRECRAWL_API_KEY=fc-your_key_here
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# Writable yt-dlp overlay when the venv is not upgradeable (Docker default: /data/python-packages)
# YTDLP_PACKAGE_DIR=/data/python-packages
# Bounded downloader queue and cooperative job/network deadlines.
YTDLP_MAX_CONCURRENT_DOWNLOADS=2
YTDLP_QUEUE_TIMEOUT_SEC=30
YTDLP_DOWNLOAD_TIMEOUT_SEC=180
YTDLP_SOCKET_TIMEOUT_SEC=20

# Telegram Web App admin settings, cookies, and telemetry. Set
# WEB_SETTINGS_URL to the public HTTPS URL of a reverse proxy that forwards to
# this listener, then use /web_settings or /web_telemetry in an admin DM.
# Telegram Web Apps will not open a plain HTTP URL.
# WEB_SETTINGS_URL=https://bot.example.com
WEB_SETTINGS_HOST=127.0.0.1
WEB_SETTINGS_PORT=8780
# Max age (seconds) of Telegram-signed Web App init data (60-86400).
WEB_SETTINGS_INIT_DATA_MAX_AGE=3600

# Self-update helpers (optional; used when systemd PATH omits ~/.local/bin)
# UV_EXECUTABLE=/home/you/.local/bin/uv
